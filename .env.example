# Postgres connection string
DATABASE_URL="postgresql://prdhub:prdhub@localhost:5432/prdhub"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Google sign-in (Google Cloud console > APIs & Services > Credentials > OAuth client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only people with this email domain can sign in, e.g. "yourcompany.com". Leave empty to allow any Google account.
ALLOWED_EMAIL_DOMAIN=""

# Comma-separated. These people become admins on sign-in. Everyone else starts as a viewer (read + comment);
# admins promote builders to editor on the People page.
ADMIN_EMAILS=""

# Local development only: show an email-only sign-in form. Never enable in production.
DEV_LOGIN="false"

# Where uploaded files are stored on disk (local driver). Defaults to ./uploads
UPLOAD_DIR=""
